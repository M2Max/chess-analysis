# chess-analysis - environment reference
# Copy to .env (or set in your process manager / compose file). Every variable
# is optional; the defaults in parentheses work for local dev and the Docker
# image. .env is git-ignored.

# --- server ---------------------------------------------------------------
# HTTP(S) port the Bun server listens on (3000)
#PORT=3000

# Enable HTTPS with a self-signed cert. REQUIRED for the multi-threaded
# engine when the app is reached by LAN IP (SharedArrayBuffer needs a secure
# context). The cert must carry SAN=DNS:localhost,IP:<your-LAN-IP>.
#HTTPS=true
#SSL_KEY=/app/certs/key.pem
#SSL_CERT=/app/certs/cert.pem

# SQLite database file. Default: <repo>/data/review.db (Docker image:
# /app/data/review.db on the mounted ./data volume).
#DATABASE_PATH=./data/review.db

# --- client (Vite, build time) ---------------------------------------------
# Override the games API base (defaults to the public chess.com API).
# Set in the Vite env, e.g. VITE_API_BASE=https://api.example.com/pub
#VITE_API_BASE=

# --- scripts / tests (dev only) --------------------------------------------
# Set to 1 to import the server without opening a socket (used by tests).
#REVIEW_SERVER_NO_LISTEN=1

# --- docker compose overrides ----------------------------------------------
# Image registry + tag for docker-compose.yml (GHCR is the default).
# Self-hosted LAN registry example:
#REGISTRY=<host:port>/<user>
#TAG=latest
